# input
generate:
    count: 1
    interval: ""
    mapping: 'root = {}'
# resources
processor_resources:
    - label: r
      for_each:
        - mapping: 'root = this'
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: ${STRICT}
    concurrent: false
    lines: [9, 13]
    processors:
        - retry:
            parallel: ${PARALLEL}
            processors:
                - resource: r
        - try:
            - rpcn_debug_stepper:
                id: 1
                parent: 0
                mode: try
                strict: ${STRICT}
                concurrent: false
                repeat: msg
                lines: [14]
                processors:
                    - mapping: 'root.a = 1'
