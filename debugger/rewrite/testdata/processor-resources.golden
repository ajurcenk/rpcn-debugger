# input
generate:
    count: 1
    interval: ""
    mapping: 'root = {"a": 1}'
# resources
processor_resources:
    - label: enrich
      branch:
        request_map: 'root = this.a'
        processors:
            - rpcn_debug_stepper:
                id: 1
                parent: -1
                mode: all
                strict: false
                concurrent: false
                lines: [16]
                processors:
                    - mapping: 'root = this * 2'
        result_map: 'root.b = this'
    - label: plain
      mapping: 'root = this'
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [9]
    processors:
        - resource: enrich
# warnings
# lines
(0, 0) pipeline.processors[0] line 9
(0, 1) pipeline.processors line 8
(1, 0) processor_resources.enrich.branch.processors[0] line 16
(1, 1) processor_resources.enrich.branch.processors line 15
