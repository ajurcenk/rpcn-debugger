# input
generate:
    count: 1
    interval: ""
    mapping: 'root = {}'
# resources
processor_resources:
    - label: b
      branch:
        processors:
            - resource: via_b
    - label: r
      try:
        - mapping: 'root = this'
    - label: via_b
      for_each:
        - mapping: 'root = this'
    - label: free
      catch:
        - rpcn_debug_stepper:
            id: 1
            parent: -1
            mode: all
            strict: false
            concurrent: false
            lines: [29]
            processors:
                - mapping: 'root = this'
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [9, 11, 14]
    processors:
        - workflow:
            branch_resources: [b]
        - parallel:
            processors:
                - resource: r
        - resource: free
# warnings
pipeline.processors[0].workflow (line 9): workflow runs its processors concurrently, so it runs as one step and nothing inside it is stepped
pipeline.processors[1].parallel (line 11): parallel runs its processors concurrently, so it runs as one step and nothing inside it is stepped
processor_resources.b (line 17): this resource is used inside a parent that runs as one step (a concurrent or unknown parent), so it runs as one step and nothing inside it is stepped
processor_resources.r (line 21): this resource is used inside a parent that runs as one step (a concurrent or unknown parent), so it runs as one step and nothing inside it is stepped
processor_resources.via_b (line 24): this resource is used inside a parent that runs as one step (a concurrent or unknown parent), so it runs as one step and nothing inside it is stepped
# lines
(0, 0) pipeline.processors[0] line 9
(0, 1) pipeline.processors[1] line 11
(0, 2) pipeline.processors[2] line 14
(0, 3) pipeline.processors line 8
(1, 0) processor_resources.free.catch[0] line 29
