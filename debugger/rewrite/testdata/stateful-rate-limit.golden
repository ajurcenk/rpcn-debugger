# input
generate:
    count: 1
    interval: ""
    mapping: 'root = 1'
# resources
rate_limit_resources:
    - label: rl
      local:
        count: 10
        interval: 1s
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [9]
    processors:
        - try:
            - rpcn_debug_stepper:
                id: 1
                parent: 0
                mode: try
                strict: false
                concurrent: false
                repeat: msg
                lines: [10, 12]
                processors:
                    - rate_limit:
                        resource: rl
                    - mapping: 'root = this'
