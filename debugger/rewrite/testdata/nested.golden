# input
generate:
    count: 1
    interval: ""
    mapping: 'root = {"n": 1}'
# resources
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [9, 14, 20, 23, 26, 28, 32, 36, 40]
    processors:
        - branch:
            request_map: 'root = this.n'
            processors:
                - rpcn_debug_stepper:
                    id: 1
                    parent: 0
                    mode: all
                    strict: false
                    concurrent: false
                    lines: [12]
                    processors:
                        - mapping: 'root = this * 10'
            result_map: 'root.branched = this'
        - switch:
            - check: 'this.n == 1'
              processors:
                - rpcn_debug_stepper:
                    id: 2
                    parent: 0
                    mode: all
                    strict: false
                    concurrent: false
                    lines: [17]
                    processors:
                        - mapping: 'root.case = "one"'
            - processors:
                - rpcn_debug_stepper:
                    id: 3
                    parent: 0
                    mode: all
                    strict: false
                    concurrent: false
                    lines: [19]
                    processors:
                        - mapping: 'root.case = "other"'
        - try:
            - rpcn_debug_stepper:
                id: 4
                parent: 0
                mode: try
                strict: false
                concurrent: false
                repeat: msg
                lines: [21, 22]
                processors:
                    - mapping: 'root.tried = true'
                    - mapping: 'root.tried_again = true'
        - catch:
            - rpcn_debug_stepper:
                id: 5
                parent: 0
                mode: all
                strict: false
                concurrent: false
                lines: [24]
                processors:
                    - log:
                        message: 'caught'
        - for_each:
            - rpcn_debug_stepper:
                id: 6
                parent: 0
                mode: all
                strict: false
                concurrent: false
                repeat: msg
                lines: [27]
                processors:
                    - mapping: 'root.each = true'
        - while:
            check: 'this.loops.or(0) < 2'
            processors:
                - rpcn_debug_stepper:
                    id: 7
                    parent: 0
                    mode: all
                    strict: false
                    concurrent: false
                    repeat: loop
                    lines: [31]
                    processors:
                        - mapping: 'root.loops = this.loops.or(0) + 1'
        - group_by:
            - check: 'this.n == 1'
              processors:
                - rpcn_debug_stepper:
                    id: 8
                    parent: 0
                    mode: all
                    strict: false
                    concurrent: false
                    repeat: group
                    lines: [35]
                    processors:
                        - mapping: 'root.group = 0'
        - retry:
            max_retries: 2
            processors:
                - rpcn_debug_stepper:
                    id: 9
                    parent: 0
                    mode: all
                    strict: false
                    concurrent: false
                    repeat: attempt
                    max_attempts: 2
                    lines: [39]
                    processors:
                        - mapping: 'root.retried = true'
        - label: outer
          branch:
            processors:
                - rpcn_debug_stepper:
                    id: 10
                    parent: 0
                    mode: all
                    strict: false
                    concurrent: false
                    lines: [43]
                    processors:
                        - try:
                            - rpcn_debug_stepper:
                                id: 11
                                parent: 10
                                mode: try
                                strict: false
                                concurrent: false
                                repeat: msg
                                lines: [44]
                                processors:
                                    - mapping: 'root = this'
