# input
generate:
    count: 1
    interval: ""
    mapping: 'root = {}'
# resources
cache_resources:
    - label: r
      redis:
        url: redis://cache:6379
    - label: m
      memory: {}
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [11, 17, 19, 22, 27, 31, 36, 38]
    processors:
        - sql_insert:
            driver: postgres
            dsn: postgres://user:secret@db:5432/app
            table: t
            columns: [a]
            args_mapping: 'root = [this.a]'
        - http:
            url: http://x
        - http:
            url: http://x
            verb: GET
        - cache:
            resource: r
            operator: set
            key: k
            value: v
        - cache:
            resource: r
            operator: get
            key: k
        - cache:
            resource: m
            operator: set
            key: k
            value: v
        - javascript:
            code: 'benthos.v0_fetch("http://y", {}, "POST", "")'
        - openai_chat_completion:
            api_key: k
            model: gpt
            tools:
                - name: notify
                  description: d
                  parameters: {properties: {}}
                  processors:
                    - http:
                        url: http://hook
