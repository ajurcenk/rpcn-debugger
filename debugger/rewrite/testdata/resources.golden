# input
label: in
generate:
    count: 1
    interval: ""
    mapping: 'root = {"a": 1}'
# resources
processor_resources:
    - label: double
      mapping: 'root.a = this.a * 2'
# stepper
rpcn_debug_stepper:
    id: 0
    lines: [11, 12]
    processors:
        - resource: double
        - log:
            message: hi
# children
pipeline.processors[0] line 11
pipeline.processors[1] line 12
