# input
broker:
    inputs:
        - generate:
            count: 1
            interval: ""
            mapping: 'root = {}'
          processors:
            - sql_insert:
                driver: postgres
                dsn: postgres://db/app
                table: audit
                columns: [a]
                args_mapping: 'root = [1]'
            - resource: capture_only
        - resource: in1
# resources
input_resources:
    - label: in1
      generate:
        count: 1
        interval: ""
        mapping: 'root = {}'
      processors:
        - http:
            url: http://in
processor_resources:
    - label: capture_only
      command:
        name: touch
    - label: both
      aws_lambda:
        function: f
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [20]
    processors:
        - resource: both
# stepper 1
rpcn_debug_stepper:
    id: 1
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [24]
    processors:
        - resource: both
# warnings
