# input
broker:
    inputs:
        - file:
            paths: [a.txt]
            auto_replay_nacks: true
        - file:
            paths: [b.txt]
            auto_replay_nacks: true
        - resource: r
# resources
input_resources:
    - label: r
      generate:
        mapping: 'root = {}'
        auto_replay_nacks: true
