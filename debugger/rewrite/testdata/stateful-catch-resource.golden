# input
generate:
    count: 1
    interval: ""
    mapping: 'root = 1'
# resources
processor_resources:
    - label: c
      cached:
        cache: mem
        key: '${! this }'
        processors:
            - mapping: 'root = this'
cache_resources:
    - label: mem
      memory: {}
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [9]
    processors:
        - catch:
            - rpcn_debug_stepper:
                id: 1
                parent: 0
                mode: all
                strict: false
                concurrent: false
                lines: [10, 11]
                processors:
                    - resource: c
                    - mapping: 'root = this'
# warnings
pipeline.processors[0].catch (line 9): the engine runs the catch children over every message one child at a time, while the debugger steps one message through all of them, so children that share state across messages (such as a cache) may give different output
processor_resources.c.cached (line 18): cached is not a parent processor the debugger knows, so it runs as one step and nothing inside it is stepped
# delivery
output line 13
# lines
(0, 0) pipeline.processors[0] line 9
(0, 1) pipeline.processors line 8
(1, 0) pipeline.processors[0].catch[0] line 10
(1, 1) pipeline.processors[0].catch[1] line 11
(1, 2) pipeline.processors[0].catch line 9
