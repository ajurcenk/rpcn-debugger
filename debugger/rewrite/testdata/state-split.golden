# input
broker:
    inputs:
        - generate:
            count: 1
            interval: ""
            mapping: 'root = {}'
          processors:
            - cache:
                resource: shared
                operator: set
                key: k
                value: v
            - rate_limit:
                resource: rl
# resources
cache_resources:
    - label: shared
      memory: {}
    - label: steponly
      memory: {}
rate_limit_resources:
    - label: rl
      local:
        count: 10
        interval: 1s
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [22, 26, 31]
    processors:
        - cache:
            resource: shared
            operator: get
            key: k
        - cache:
            resource: steponly
            operator: set
            key: k
            value: v
        - rate_limit:
            resource: rl
# warnings
