# input
generate:
    count: 1
    interval: ""
    mapping: 'root = 1'
# resources
cache_resources:
    - label: mem
      memory: {}
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [9]
    processors:
        - try:
            - rpcn_debug_stepper:
                id: 1
                parent: 0
                mode: try
                strict: false
                concurrent: false
                repeat: msg
                lines: [10, 11]
                processors:
                    - mapping: 'root = this'
                    - branch:
                        processors:
                            - rpcn_debug_stepper:
                                id: 2
                                parent: 1
                                mode: all
                                strict: false
                                concurrent: false
                                lines: [13]
                                processors:
                                    - cache:
                                        resource: mem
                                        operator: get
                                        key: '${! this }'
# warnings
pipeline.processors[0].try (line 9): the engine runs the try children over every message one child at a time, while the debugger steps one message through all of them, so children that share state across messages (such as a cache) may give different output
