# input
generate:
    count: 1
    interval: ""
    mapping: 'root = {}'
# resources
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: true
    concurrent: false
    lines: [9, 11, 14]
    processors:
        - catch:
            - rpcn_debug_stepper:
                id: 1
                parent: 0
                mode: all
                strict: false
                concurrent: false
                lines: [10]
                processors:
                    - mapping: 'root.caught = true'
        - retry:
            processors:
                - rpcn_debug_stepper:
                    id: 2
                    parent: 0
                    mode: all
                    strict: true
                    concurrent: false
                    repeat: attempt
                    max_attempts: 0
                    lines: [13]
                    processors:
                        - mapping: 'root.unbounded = true'
        - retry:
            max_retries: ${MAX_RETRIES:3}
            processors:
                - rpcn_debug_stepper:
                    id: 3
                    parent: 0
                    mode: all
                    strict: true
                    concurrent: false
                    repeat: attempt
                    max_attempts: ${MAX_RETRIES:3}
                    lines: [17]
                    processors:
                        - mapping: 'root.interpolated = true'
