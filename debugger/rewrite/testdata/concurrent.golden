# input
generate:
    count: 1
    interval: ""
    mapping: 'root = {}'
# resources
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [9, 10, 16]
    processors:
        - mapping: 'root.a = 1'
        - parallel:
            cap: 2
            processors:
                - branch:
                    processors:
                        - mapping: 'root = this'
        - retry:
            parallel: true
            processors:
                - mapping: 'root.r = 1'
