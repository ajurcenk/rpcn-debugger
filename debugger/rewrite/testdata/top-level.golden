# input
generate:
    count: 1
    interval: ""
    mapping: 'root = 1'
# resources
# stepper 0
rpcn_debug_stepper:
    id: 0
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [7]
    processors:
        - mapping: 'root = this + 1'
# stepper 1
rpcn_debug_stepper:
    id: 1
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [11]
    processors:
        - mapping: 'root = this * 2'
# stepper 2
rpcn_debug_stepper:
    id: 2
    parent: -1
    mode: all
    strict: false
    concurrent: false
    lines: [15]
    processors:
        - mapping: 'root = this - 1'
