{
  "name": "pipeline-debugger-for-redpanda-connect",
  "displayName": "Pipeline Debugger for Redpanda Connect",
  "description": "Step a captured batch through a Redpanda Connect pipeline in the VS Code debugger.",
  "version": "0.0.1",
  "publisher": "ajurcenk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajurcenk/rpcn-debugger.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebugResolve:redpanda-connect"
  ],
  "contributes": {
    "configuration": {
      "title": "Redpanda Connect Debugger",
      "properties": {
        "rpcnDebug.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the `rpcn-debug` binary that runs debug sessions, for example `<repo>/bin/rpcn-debug`. Machine-scoped, so a workspace can't override it."
        }
      }
    },
    "breakpoints": [
      {
        "language": "yaml"
      }
    ],
    "debuggers": [
      {
        "type": "redpanda-connect",
        "label": "Redpanda Connect",
        "languages": [
          "yaml"
        ],
        "initialConfigurations": [
          {
            "type": "redpanda-connect",
            "request": "launch",
            "name": "Debug pipeline"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package --no-dependencies -o dist/",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.120.0",
    "@vscode/debugadapter-testsupport": "1.68.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "6.0.3"
  }
}
